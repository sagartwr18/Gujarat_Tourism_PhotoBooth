# ============================================================
# Email delivery — Brevo HTTP API (recommended)
# Works on hosts that block outbound SMTP ports, such as Render's
# free tier. The API uses HTTPS (443), so nothing needs unblocking.
#
# Setup:
#   1. Create a Brevo account and verify a sender address or domain
#      (Senders, Domains & Dedicated IPs → Senders).
#   2. Create an API key (SMTP & API → API Keys).
#   3. Use the verified sender address in MAIL_FROM_ADDRESS.
# ============================================================
EMAIL_API_KEY=xkeysib-your-brevo-api-key
MAIL_FROM_ADDRESS=verified-sender@yourdomain.com
MAIL_FROM_NAME=Gujarat Photo Booth

# Optional overrides
# EMAIL_API_URL=https://api.brevo.com/v3/smtp/email
# EMAIL_API_TIMEOUT_MS=20000

# ============================================================
# SMTP fallback — used only when EMAIL_API_KEY is empty
# (handy for local development; most PaaS free tiers block these ports)
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Optional when MAIL_FROM_ADDRESS is set. Supports "Name <email>" format.
MAIL_FROM="Vibrant Gujarat Photo Booth <your_email@gmail.com>"

# ============================================================
# Supabase (server-side only — never expose the service-role key)
# ============================================================
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ============================================================
# Server
# ============================================================
PORT=3001

# Browser origins allowed to call the API (comma-separated, no trailing slash).
# Leave empty for local development; set it in production, e.g.
# ALLOWED_ORIGINS=https://your-project.vercel.app
ALLOWED_ORIGINS=

# Max email requests per IP inside the window (defaults: 5 per 10 minutes).
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=600000

# ============================================================
# Frontend (Vercel)
# Only needed when the frontend is hosted separately from the API.
# Leave unset locally so requests go through the Vite proxy to localhost:3001.
# ============================================================
# VITE_API_URL=https://your-service.onrender.com
